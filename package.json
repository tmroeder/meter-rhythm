{
  "name": "meter-as-rhythm",
  "version": "0.1.0",
  "description": "Interactive demonstration of Hasty's metrical projection, ported from the 1998 Java applet",
  "scripts": {
    "build": "./build.sh",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:update": "playwright test --update-snapshots",
    "gallery": "playwright test tests/render.spec.ts && open screenshots/index.html",
    "test:ios": "ios-tests/run.sh"
  },
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "private": true
}
